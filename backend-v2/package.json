{
  "name": "apna-society-backend-v2",
  "version": "2.0.0",
  "description": "Apna Society Backend V2 – MongoDB/Express foundation",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "reset:launch": "tsx scripts/reset-launch.ts",
    "prepare:admin": "tsx scripts/create-admin.ts",
    "migrate:password-auth": "tsx scripts/migrate-password-auth.ts",
    "backup:mongo": "bash scripts/backup-mongodb.sh",
    "restore:mongo": "bash scripts/restore-mongodb.sh",
    "indexes:verify": "tsx scripts/verify-indexes.ts",
    "load:k6": "bash scripts/load-k6.sh",
    "load:smoke": "PROFILE=smoke SCENARIO=health bash scripts/load-k6.sh",
    "load:normal": "PROFILE=normal SCENARIO=health bash scripts/load-k6.sh",
    "load:stress": "PROFILE=stress SCENARIO=health bash scripts/load-k6.sh",
    "load:spike": "PROFILE=spike SCENARIO=health bash scripts/load-k6.sh",
    "load:soak": "PROFILE=soak SCENARIO=health bash scripts/load-k6.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "swagger-jsdoc": {
      "yaml": "2.0.0-1"
    },
    "vite": {
      "yaml": "2.9.1"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "resend": "^4.1.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.2"
  }
}
