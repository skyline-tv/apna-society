# Server
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# MongoDB (never commit real credentials)
# Dev single node:
MONGODB_URI=mongodb://localhost:27017/apna_society
# Production / Docker replica set (required for transactions):
# MONGODB_URI=mongodb://mongo:27017/apna_society?replicaSet=rs0&directConnection=true
# MONGODB_URI=mongodb+srv://user:pass@cluster/apna_society

# JWT — must be distinct, >=32 chars; production rejects placeholders
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-different!!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Email notifications (Resend) — required in production; not used for login OTP
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Apna Society <noreply@example.com>"

# Login SMS OTP only (MSG91 SendOTP / Verify / Resend).
# Docs: https://docs.msg91.com/p/module.json?collectionId=C6NTmvei0Af4 → OTP
# Keep SMS_OTP_ENABLED=false until DLT Template Id is mapped on the MSG91 OTP template
# (log error "DLT Template id not found" = panel mapping missing).
# Guide: docs/MSG91_LOGIN_OTP.md and ../app/docs/MSG91_MOBILE_OTP_DEPLOYMENT.md
SMS_PROVIDER=msg91
SMS_OTP_ENABLED=false
# Dev only: skip MSG91 and accept fixed OTP 123456 (rejected in production)
SMS_OTP_DEV_BYPASS=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com/api/v5
SMS_OTP_EXPIRY_MINUTES=5
SMS_OTP_LENGTH=6

# CORS (comma-separated origins)
CORS_ORIGINS=https://apnasociety.skylinetv.com

LOG_LEVEL=info

# Billing / payments
BILLING_ANNUAL_INTEREST_BPS=2400
OFFLINE_PAYMENTS_ENABLED=true
# mock (default) | razorpay
# First publish: no in-app checkout. Admin records cash/cheque only.
# Demo simulation is forbidden in production. Live charges require ALL of:
# provider=razorpay, PAYMENTS_LIVE_ENABLED=true, and secrets.
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENTS_LIVE_ENABLED=false
DEMO_PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Visitors — entry OTP is emailed (no SMS). Prefer visitorEmail on create; else resident email.
VISITOR_OTP_TTL_MS=600000
VISITOR_OTP_MAX_ATTEMPTS=5
VISITOR_PENDING_TTL_MS=1800000
# Walk-in (no OTP) resident approval window. Default 2 minutes.
VISITOR_WALK_IN_TTL_MS=120000
VISITOR_EXPIRY_WORKER_ENABLED=true
VISITOR_EXPIRY_WORKER_INTERVAL_MS=60000

# Firebase Cloud Messaging. Keep FCM_ENABLED=false until a service account is configured.
# Mount secrets/firebase-service-account.json read-only in Compose. Never commit it.
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional local-only fallback. Prefer FIREBASE_SERVICE_ACCOUNT_PATH. Never commit this value.
FCM_SERVICE_ACCOUNT_JSON=
PUSH_RETRY_WORKER_ENABLED=false
PUSH_RETRY_WORKER_INTERVAL_MS=60000

# Attachments: local | memory | s3  (memory forbidden in production)
COMPLAINT_STORAGE_PROVIDER=local
COMPLAINT_STORAGE_LOCAL_DIR=./storage/complaints
COMPLAINT_ATTACHMENT_MAX_BYTES=5242880
COMPLAINT_ATTACHMENT_MAX_COUNT=5
COMPLAINT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

FACILITY_PENDING_BOOKING_TTL_MS=86400000
FACILITY_BOOKING_WORKER_ENABLED=true
FACILITY_BOOKING_WORKER_INTERVAL_MS=60000

ANNOUNCEMENT_WORKER_ENABLED=true
ANNOUNCEMENT_WORKER_INTERVAL_MS=30000

# Daily late-payment interest (derived, idempotent). Hourly check; one pass per society civil day.
INTEREST_WORKER_ENABLED=true
INTEREST_WORKER_INTERVAL_MS=3600000
# Daily overdue bill reminders (uses existing interest totals; one per bill per civil day).
OVERDUE_REMINDER_WORKER_ENABLED=true
OVERDUE_REMINDER_WORKER_INTERVAL_MS=3600000
ANNOUNCEMENT_STORAGE_PROVIDER=local
ANNOUNCEMENT_STORAGE_LOCAL_DIR=./storage/announcements
ANNOUNCEMENT_ATTACHMENT_MAX_BYTES=5242880
ANNOUNCEMENT_ATTACHMENT_MAX_COUNT=5
ANNOUNCEMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# S3-compatible object storage (when STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=apna-society

# Redis cache (optional — API fail-opens to MongoDB when disabled/unavailable)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=apna:
# Docker Compose defaults password to changeme-redis-password when enabled
CACHE_TTL_DASHBOARD_SECONDS=45
CACHE_TTL_REPORTS_SECONDS=45
CACHE_TTL_WINGS_SECONDS=300
CACHE_TTL_FACILITIES_SECONDS=120
CACHE_TTL_ANNOUNCEMENTS_SECONDS=45
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
